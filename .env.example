# Configuration of one installation. Copy to .env — or just run ./deploy.sh,
# which creates .env, generates the secrets and asks for the rest.
# Docker Compose reads this file for ${...} substitution; the backend gets it
# whole (env_file), the other services only what they need.

# ===== Required — deploy.sh asks for these on the first run =====

# What browsers open. Links in e-mails and Telegram are built from it, and the
# scheme decides whether the session cookie is marked Secure (https) or not.
APP_PUBLIC_URL=https://helpdesk.example.com

# E-mail of the first administrator. Used only once, on an EMPTY database; the
# password is generated and printed by deploy.sh (or set BOOTSTRAP_ADMIN_PASSWORD).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ===== Generated by deploy.sh — keep a copy with your backups =====

MONGODB_USERNAME=hd
MONGODB_PASSWORD=
MONGODB_DATABASE=hd

# Signs the session cookie and encrypts TOTP secrets.
# Rotating it logs everybody out and makes existing TOTP secrets unreadable.
BETTER_AUTH_SECRET=

# AES-256 key (base64, 32 bytes) for every secret stored in the database:
# mail passwords, AI and RouterOS credentials, Mikrotik backups.
# Rotating it makes all of them unreadable. (Previous name: MIKROTIK_ENC_KEY.)
APP_ENC_KEY=

# Shared secret between the backend and tg-service.
TG_API_TOKEN=

# Shared secret between the backend and msg-gateway (Telegram and WhatsApp
# sessions of «Диалоги»). Empty = the gateway API refuses every request.
MSG_GATEWAY_TOKEN=

# ===== Optional =====

# The only published port. Use "127.0.0.1:8080" when a reverse proxy on the same
# host is the only client.
HTTP_PORT=8080

# Where MongoDB is reachable from outside its container. Loopback by default
# (mongosh, sync-dev-db.sh on this host). "<lan-ip>:27017" publishes it on the
# LAN for Compass and remote tools — never on a public interface: Docker
# bypasses ufw, so the firewall would not protect it. Connection string:
# mongodb://<MONGODB_USERNAME>:<MONGODB_PASSWORD>@<lan-ip>:27017/?authSource=admin
MONGO_PORT=127.0.0.1:27017

# Proxies in front of the backend that append X-Forwarded-For: 1 = the built-in
# nginx only; 2 = plus your external reverse proxy. Too low: the login rate
# limiter counts everybody as one client. Too high: a client can spoof its IP.
TRUST_PROXY_HOPS=1

# Telegram bot token from @BotFather. Empty = no Telegram. deploy.sh switches
# the `telegram` compose profile on when this is filled in.
TG_TOKEN=
COMPOSE_PROFILES=

# Object storage for attachments. All four of ID / SECRET / BUCKET / ENDPOINT set
# → S3; otherwise files live in the hd_uploads volume.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=true
S3_KMS_KEY_ID=

# First administrator / company / organisation on an empty database.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_COMPANY_TITLE=
BOOTSTRAP_ORG_NAME=

# First ticket number on an empty database (default 1).
TICKET_COUNTER_STARTING_NUMBER=
# Write a ticket-log entry for every sent notification.
ADD_TICKET_LOG=
# Extra origins allowed to call the API with cookies (comma-separated). Empty in
# the normal setup: the app and the API share one origin.
CORS_ORIGINS=
# Fallback PRO32 Connect (GetScreen) API key; NVD API key for CVE lookups.
GETSCREEN_ROOT_API=
NVD_API_KEY=
# Private addresses HD may connect to directly as Mikrotik devices (a router in
# the server's own LAN). IPv4 addresses or CIDR blocks, comma-separated, e.g.
# 10.0.40.1,10.0.60.0/24. Empty: only public addresses are accepted.
MIKROTIK_ALLOWED_PRIVATE_NETS=
# RouterOS polling tunables (MIKROTIK_*) have sane defaults — see
# backend/services/mikrotik/connector.js if you ever need them.

# ===== Ticket tag in e-mail subjects =====

# Prefix of the tag every ticket e-mail carries in its subject: [HD-51713].
# A reply is matched to its ticket by this tag. Latin letters, digits and
# hyphen, 2-12 characters; an invalid value stops the backend at start.
# Set it once at install: changing it later orphans replies to mail already
# sent, unless the old prefix is listed below.
# Empty = the product default, HD. Keep the line: deploy.sh takes a .env
# without this key for an installation that predates the setting and stops.
TICKET_SUBJECT_PREFIX=
# Earlier prefixes still recognised in replies, comma-separated. New mail
# always goes out with TICKET_SUBJECT_PREFIX.
#TICKET_SUBJECT_PREFIXES_ACCEPTED=

# ===== Updating an installation that predates the brand settings =====

# The portal name and the e-mail signature the installation was using; read
# once by the seedBrand migration (<br> or \n separates signature lines).
# Without them both switch to the product defaults on that update.
#LEGACY_BRAND_NAME=
#LEGACY_BRAND_SIGNATURE=

# ===== Mail mode =====

# Where outgoing e-mail really goes. Read by the backend at start; NODE_ENV
# does not matter. An unknown value stops the backend at start.
#   live    — letters go to their real recipients;
#   sandbox — EVERY letter goes to MAIL_SANDBOX_RECIPIENT instead, with the
#             intended address in the subject (for hosts running on a copy of
#             production data);
#   off     — nothing is sent: each letter is marked as not sent, and Settings
#             show that sending is switched off on the server.
# Unset means off. deploy.sh writes "off" into a new .env and "live" into the
# .env of an installation that existed before this setting.
MAIL_MODE=off
# Required with MAIL_MODE=sandbox (the backend refuses to start without it).
#MAIL_SANDBOX_RECIPIENT=you@example.com

# ===== Error tracking =====

# DSN of a Sentry-compatible service for browser errors:
# https://<key>@<host>/<project>. Empty = error tracking is off and the app
# contacts no third party. deploy.sh derives SENTRY_CSP_ORIGIN (scheme://host)
# from it for the frontend's Content-Security-Policy; after changing the DSN
# run ./deploy.sh (or ./deploy.sh env and recreate the frontend container).
SENTRY_DSN=

# ===== Dev machine only =====

# Makes plain `docker compose up` use the dev stack.
#COMPOSE_FILE=compose.dev.yml
# On a dev machine use MAIL_MODE=sandbox with your own address — see "Mail
# mode" above.

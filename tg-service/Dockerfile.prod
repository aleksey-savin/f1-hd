# Node 24 LTS. У сервиса нет шага сборки — Node исполняет .ts, стирая типы, —
# поэтому нет и стадии билдера: ставим только прод-зависимости и копируем исходники.
#
# Компилятора в образе нет намеренно: хранилище — встроенный `node:sqlite`, а не
# нативный модуль, который на musl обычно собирается из исходников и тянет за
# собой python3/make/g++. Сервис должен разворачиваться на любой машине без
# возни с тулчейном.
FROM node:24-alpine AS deps

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --prod --frozen-lockfile


FROM node:24-alpine AS production

ENV NODE_ENV=production

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src

# Состояние сервиса (SQLite) — том. Владелец каталога должен совпадать с тем,
# кем запущен процесс, иначе первая же запись упадёт правом доступа.
RUN mkdir -p data && chown -R node:node /app

USER node

# Настоящая проверка, а не заглушка: у прежнего бота healthcheck был
# `node -e "process.exit(0)"`, то есть контейнер считался живым всегда — в том
# числе когда бот молчал.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.HEALTH_PORT||8081)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["pnpm", "start:prod"]
